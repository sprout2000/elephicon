{
  "name": "elephicon",
  "productName": "Elephicon",
  "description": "Elephicon generates Apple ICNS and Microsoft ICO files from PNG, SVG and other images.",
  "version": "4.3.1",
  "license": "MIT",
  "private": true,
  "author": {
    "name": "sprout2000"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:sprout2000/elephicon.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "tauri": "tauri",
    "release": "tauri build && node scripts/zip.mjs",
    "zip": "node scripts/zip.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typeface-roboto": "^1.1.13"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.9",
    "@tauri-apps/cli": "^2.12.6",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.10",
    "@types/react": "^19.3.2",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.2",
    "jsdom": "^31.0.1",
    "sass": "^1.108.2",
    "typescript": "~7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  }
}
